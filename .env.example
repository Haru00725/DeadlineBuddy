# DeadlineBuddy Environment Variables
# Copy this file to .env.local and fill in your values

# AI API Key (required for AI notice scanning)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# AI Model (optional, defaults to gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest
